{
  "name": "greencode",
  "version": "1.0.0",
  "description": "CLI de gestao de logistica reversa de equipamentos eletronicos (AV1)",
  "main": "dist/index.js",
  "bin": {
    "greencode": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "tsc -p . && node dist/index.js",
    "test:jornada": "tsc -p . && node dist/index.js --script tests/jornada-completa.gcs --datadir tests/tmp-jornada",
    "test:falhas": "tsc -p . && node dist/index.js --script tests/cenarios-falha.gcs --datadir tests/tmp-falhas"
  },
  "keywords": ["cli", "logistica-reversa", "greencode"],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
